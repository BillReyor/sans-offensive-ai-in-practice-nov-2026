# Copy to .env and fill in
ANTHROPIC_API_KEY=<add key>

# PentestGPT auth mode: "anthropic" / "openrouter" / "manual" (per upstream)
PENTESTGPT_AUTH_MODE=anthropic

# ARTEX (optional 4th tool, `artex` profile). Built from source; reuses
# ANTHROPIC_API_KEY above. Leave ARTEX_LLM_MODEL empty to pick the model in the
# ARTEX UI instead.
ARTEX_LLM_MODEL=
