# Copy to .env and fill in
ANTHROPIC_API_KEY=<add key>

# PentestGPT auth mode: "anthropic" / "openrouter" / "manual" (per upstream)
PENTESTGPT_AUTH_MODE=anthropic

# ARTEX (optional 4th tool, `artex` profile). Built from source; reuses
# ANTHROPIC_API_KEY above.
#   ARTEX_LLM_PROVIDER: "anthropic" (default) or "openai".
#   ARTEX_LLM_MODEL: leave empty to pick the model in the ARTEX UI. ARTEX
#     otherwise defaults to an Opus model; for a cost-controlled workshop set a
#     cheaper one here, e.g. claude-sonnet-4-6.
ARTEX_LLM_PROVIDER=anthropic
ARTEX_LLM_MODEL=
